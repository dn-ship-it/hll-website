# Local development (SQLite — no Docker required)
DATABASE_URI=file:./payload.db
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Production (PostgreSQL on AWS Mumbai / MeghRaj)
# DATABASE_URI=postgresql://user:pass@host:5432/hll_cms

# Optional S3-compatible storage (AWS S3 or MinIO). Omit for local disk in ./media
# S3_BUCKET=hll-media-prod
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# Public site URL (for admin preview links)
# NEXT_PUBLIC_SERVER_URL=http://localhost:43141
